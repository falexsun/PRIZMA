# --- Postgres ---
POSTGRES_USER=content_tracker
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=content_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://content_tracker:replace_with_a_strong_database_password@postgres:5432/content_tracker

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- App ---
ENV=production
LOG_LEVEL=WARNING
CORS_ORIGINS=http://localhost:5000

# --- Platform API keys ---
VK_SERVICE_TOKEN=
VK_USER_TOKEN=

# --- MAX ---
MAX_HEADLESS_ENABLED=true
MAX_SESSION_PATH=max_session.json

# --- First admin user ---
# setup.bat fills INITIAL_ADMIN_PASSWORD automatically on first install.
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_ORG_NAME=Head office
INITIAL_ADMIN_DEPARTMENT=Administration
DEFAULT_ACCOUNTS_PATH=default_accounts.json

# --- Proxy routing ---
# NON_RU_PROXY используется для Telegram
# RU_PROXY используется для Дзен, Одноклассники
NON_RU_PROXY=
RU_PROXY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
